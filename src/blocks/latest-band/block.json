{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "aniacieske/latest-band",
	"version": "0.1.0",
	"title": "Thought & Latest",
	"category": "aniacieske",
	"icon": "format-quote",
	"description": "The band below the story grid: the month's thought and photo, Ani's Perch and Ani's Vids, and the categories, with the accreditation logos in a row beneath.",
	"keywords": [ "thought", "latest", "podcast", "video", "perch", "categories", "accreditations" ],
	"textdomain": "aniacieske-2026",
	"attributes": {
		"align": { "type": "string", "default": "full" },
		"thoughtTitle": { "type": "string", "default": "Thought of the Month" },
		"thoughtImageId": { "type": "number", "default": 0 },
		"thoughtText": { "type": "string", "default": "" },
		"thoughtPostId": { "type": "number", "default": 0 },
		"latestTitle": { "type": "string", "default": "Latest" },
		"perchLabel": { "type": "string", "default": "Ani's Perch" },
		"perchUrl": { "type": "string", "default": "" },
		"vidsLabel": { "type": "string", "default": "Ani's Vids" },
		"vidsUrl": { "type": "string", "default": "" },
		"categoriesTitle": { "type": "string", "default": "Categories" },
		"freeLabel": { "type": "string", "default": "Free content" },
		"paidLabel": { "type": "string", "default": "Paid content" },
		"categoryIds": {
			"type": "array",
			"default": [],
			"items": { "type": "number" }
		},
		"accreditationsTitle": {
			"type": "string",
			"default": "Current & Pending Accreditations"
		},
		"accreditationIds": {
			"type": "array",
			"default": [],
			"items": { "type": "number" }
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
